# Copy this file to .env and change what you need.

LOG_LEVEL=INFO

# LLM used by RAG
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434

# LLM used by agents (must support tool calling)
AGENT_MODEL=qwen3:4b
AGENT_THINK=true
AGENT_MAX_STEPS=5

# Embeddings
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# Chunking
CHUNKER=word
CHUNK_SIZE=150
CHUNK_OVERLAP=30

# Storage, retrieval and generation
VECTOR_STORE=memory
# RERANKER options: keyword | none
RERANKER=keyword
GENERATOR=grounded
